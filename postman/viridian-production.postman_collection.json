{
  "info": {
    "name": "Viridian - Production API",
    "description": "Production FastAPI requests. Login stores an access token.",
    "schema":"https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://enterprise-knowledge-assistant-omega.vercel.app",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public status",
      "item": [
        {
          "name": "Health",
          "description": "Liveness check.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Version and model",
          "description": "Shows active provider and model.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "version"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "description": "Checks the configured session store.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "description": "Uses credentials in the environment.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{user}}\",\"password\":\"{{pass}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('accessToken',",
                  "    pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I?",
          "description": "Shows the backend-assigned role.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List my sessions",
          "description": "Lists this user's sessions.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/sessions",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "chat",
                "sessions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const sessions = pm.response.json();",
                  "  pm.test('Sessions is an array', function () {",
                  "    pm.expect(sessions).to.be.an('array');",
                  "  });",
                  "  if (sessions.length > 0) {",
                  "    pm.environment.set('sid',",
                  "      sessions[0].session_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a session",
          "description": "Creates a session.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/sessions",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "chat",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Postman demo\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('sid',",
                  "    pm.response.json().session_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get session history",
          "description": "Returns messages.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/sessions/{{sid}}",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "chat",
                "sessions",
                "{{sid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Send chat message (live model)",
          "description": "SSE; live provider usage may be charged.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/stream",
              "protocol": "https",
              "host": [
                "enterprise-knowledge-assistant-omega",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "chat",
                "stream"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{sid}}\",\"message\":\"{{q}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Chat stream returned 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
