# Copy to .env or run `make setup` to generate local development credentials.
APP_ENV=development
MOCK_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://localhost:8000
SQLITE_PATH=data/sessions.sqlite3
CORS_ORIGINS='["http://localhost:8501"]'
LOG_LEVEL=INFO
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=0.5
DEV_USERS_JSON=data/users/default.json

# LangSmith Cloud tracing to the existing agent. Keep the key in local .env.
# Inputs and outputs are hidden; only allowlisted metadata is sent.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=enterprise-knowledge-assistant
LANGSMITH_AGENT_ENVIRONMENT=local

OPENAI_API_KEY=

# Reserved for the Pinecone adapter. Search is scaffolded and raises until
# provider client, indexing, and server-side metadata filters are implemented.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
