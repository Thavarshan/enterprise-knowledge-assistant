# Copy to .env or run `make setup` to generate local development credentials.
APP_ENV=development
MOCK_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://localhost:8000
SQLITE_PATH=data/sessions.sqlite3
CORS_ORIGINS=["http://localhost:8501"]
LOG_LEVEL=INFO
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=0.5

# Optional integrations. Local mock mode does not require these.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-knowledge-assistant
LANGSMITH_WORKSPACE_ID=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
