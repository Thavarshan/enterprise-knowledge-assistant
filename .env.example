# Copy to .env or run `make setup` to generate local development credentials.
APP_ENV=development
MOCK_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://localhost:8000
MEMORY_BACKEND=sqlite
SQLITE_PATH=data/sessions.sqlite3
D1_API_URL=
D1_SERVICE_TOKEN=
D1_TIMEOUT_SECONDS=5
AUTH_SIGNING_SECRET=
AUTH_ISSUER=enterprise-knowledge-assistant
AUTH_AUDIENCE=enterprise-knowledge-assistant-api
AUTH_TOKEN_TTL_SECONDS=900
CORS_ORIGINS='["http://localhost:8501"]'
LOG_LEVEL=INFO
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=0.5
DEV_USERS_JSON=data/users/default.json

# LangSmith Cloud tracing to the existing agent. Keep the key in local .env.
# Inputs and outputs are hidden; only allowlisted metadata is sent.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=enterprise-knowledge-assistant
LANGSMITH_AGENT_ENVIRONMENT=local

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

# Pinecone retrieval is used when MOCK_MODE=false. Keep this namespace for
# synthetic assessment data and use another namespace for other collections.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=assessment-demo
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_EMBEDDING_DIMENSION=1024
PINECONE_TIMEOUT_SECONDS=15
PINECONE_DOCUMENTS_PATH=data/samples/incident_corpus.json
