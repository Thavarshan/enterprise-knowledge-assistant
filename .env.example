# Copy to .env or run `make setup` to generate local development credentials.
APP_ENV=development
MOCK_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://localhost:8000
SQLITE_PATH=data/sessions.sqlite3
CORS_ORIGINS=["http://localhost:8501"]
LOG_LEVEL=INFO
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=0.5
DEV_USERS_JSON=data/users/default.json

# Optional LangSmith tracing. Inputs, outputs, metadata, and runtime details
# are hidden; errors are anonymized. Run `make langsmith-check` to verify.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-knowledge-assistant
# Optional workspace UUID. Do not use the workspace display name here.
LANGSMITH_WORKSPACE_ID=

# Reserved for the Pinecone adapter. Search is scaffolded and raises until
# provider client, indexing, and server-side metadata filters are implemented.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
