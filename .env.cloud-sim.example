# Local-only Cloudflare Worker and D1 simulation credentials.
# These values are disposable and must never be used in a deployed service.
API_PORT=18000
UI_PORT=18501
D1_SERVICE_TOKEN=local-d1-service-token-not-for-deployment-00000000
AUTH_SIGNING_SECRET=local-auth-signing-secret-not-for-deployment-00000000
